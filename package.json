{
  "name": "agenthub",
  "version": "0.0.1",
  "description": "Use coding agents like Claude Code and Codex from an Obsidian sidebar.",
  "main": "main.js",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "AGENTHUB_E2E=1 vitest run tests/e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "link-vault": "node scripts/link-test-vault.mjs",
    "fake-agent": "node scripts/fake-acp-agent.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.6.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "preact": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/preact": "^3.2.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^16.0.0",
    "jsdom": "^30.1.1",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
